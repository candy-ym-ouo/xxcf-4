NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
WEB_PORT=8080

# PostgreSQL credentials. Docker Compose uses these values directly.
POSTGRES_DB=handcraft
POSTGRES_USER=handcraft
POSTGRES_PASSWORD=change-me

# Local API development uses DATABASE_URL. Keep it in sync with the credentials above.
DATABASE_URL=postgresql://handcraft:change-me@localhost:55432/handcraft

SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:8080
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info
TZ=Asia/Shanghai
BACKUP_DIR=./backups
